[Unit]
Description=Huginn - honeypot attacker intelligence
After=network-online.target
Wants=network-online.target

[Service]
User=huginn
Group=huginn
WorkingDirectory=/opt/huginn
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/huginn/.env
ExecStart=/usr/bin/python3 /opt/huginn/app.py serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/huginn/data
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0027
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
