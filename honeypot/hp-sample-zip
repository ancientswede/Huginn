#!/usr/bin/env python3
# hp-sample-zip — packs files the honeypot captured into a password-protected zip, ready to share with a malware
# signature project such as Sanesecurity (part of Huginn, AGPL-3.0-or-later).
#
#   hp-sample-zip SHA256 [SHA256 ...]        (as root on the honeypot; Huginn's Files page prints this command)
#
# Writes /root/hp-samples/samples-YYYYmmdd-HHMMSS.zip (mode 600), password "infected": the convention malware labs use so
# that mail filters and virus scanners leave the attachment alone. Each file is stored as <sha256>.bin without any
# execute bit, and manifest.txt lists hash, size and name. NOTHING is ever executed: files are only read, as bytes, with
# O_NOFOLLOW, and a file is only taken when its content really has the hash that was asked for.
# Standard library only (the honeypot has no internet, so no zip/7z package): traditional PKWARE encryption ("ZipCrypto")
# is written here. It keeps scanners out, which is its only job; it is not meant to keep a determined reader out.
import datetime, hashlib, os, re, shlex, struct, sys, tempfile, time, zlib

PASSWORD = b"infected"
OUT_DIR = os.environ.get("HP_SAMPLE_DIR", "/root/hp-samples")
CONF = os.environ.get("HP_EXPORT_CONF", "/etc/default/hp-export")
MAX_FILES = 50
MAX_FILE = 32 * 1024 * 1024         # Cowrie's own download limit is far lower; anything bigger is not a sample to mail
MAX_TOTAL = 64 * 1024 * 1024
MAX_SCAN = 512 * 1024 * 1024        # bytes hashed while looking for files whose name is not their hash
SHA_RE = re.compile(r"[0-9a-f]{64}")
NAME_RE = re.compile(r"[0-9a-f]{64}|(redir|tmp)_?[A-Za-z0-9_]{4,80}")   # the names hp-fileinfo looks at


def download_dirs():
    # HP_DOWNLOAD_DIRS wins (tests, odd layouts); otherwise every COWRIE_DIRS entry in /etc/default/hp-export.
    if os.environ.get("HP_DOWNLOAD_DIRS"):
        return os.environ["HP_DOWNLOAD_DIRS"].split()
    dirs = []
    try:
        with open(CONF, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                m = re.match(r"\s*COWRIE_DIRS=(.*)$", line)
                if m:
                    for d in shlex.split(m.group(1), comments=True):
                        dirs.extend(os.path.join(x, "var/lib/cowrie/downloads") for x in d.split())
    except (OSError, ValueError):
        pass
    return dirs or ["/home/cowrie/cowrie/var/lib/cowrie/downloads"]


def open_plain(path):
    # A descriptor for a regular file, never through a symlink, never bigger than MAX_FILE. None otherwise.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0))
    st = os.fstat(fd)
    if not (st.st_mode & 0o170000 == 0o100000) or st.st_size > MAX_FILE:
        os.close(fd)
        return None, None
    return fd, st


def read_fd(fd, limit=MAX_FILE):
    chunks, left = [], limit + 1
    while left > 0:
        b = os.read(fd, min(1 << 20, left))
        if not b:
            break
        chunks.append(b)
        left -= len(b)
    data = b"".join(chunks)
    return data if len(data) <= limit else None


def hash_fd(fd):
    h = hashlib.sha256()
    n = 0
    while True:
        b = os.read(fd, 1 << 20)
        if not b:
            return h.hexdigest(), n
        h.update(b)
        n += len(b)


def find(wanted, dirs):
    # {sha: (path, name, size)} for the asked hashes: only paths, never the bytes, so memory stays small however many
    # files are asked for. A name that is a hash is still checked against the content (streamed). Files whose name is
    # not their hash (echo-built, tmp_) are hashed until MAX_SCAN bytes have been read.
    found, scanned = {}, 0
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if len(found) == len(wanted):
                return found
            named = bool(SHA_RE.fullmatch(n))
            if not NAME_RE.fullmatch(n) or (named and n not in wanted):
                continue
            path = os.path.join(d, n)
            try:
                fd, st = open_plain(path)
            except OSError:
                continue
            if fd is None:
                continue
            try:
                if not named:
                    if scanned + st.st_size > MAX_SCAN:
                        continue
                    scanned += st.st_size
                sha, size = hash_fd(fd)
            except OSError:
                continue
            finally:
                os.close(fd)
            if sha in wanted and sha not in found:
                found[sha] = (path, n, size)
    return found


# ---------------------------------------------------------------- ZipCrypto (APPNOTE 6.1)
def _crc_table():
    t = []
    for i in range(256):
        c = i
        for _ in range(8):
            c = (c >> 1) ^ 0xEDB88320 if c & 1 else c >> 1
        t.append(c)
    return t


CRC = _crc_table()


class ZipCrypto:
    def __init__(self, pw):
        self.k = [0x12345678, 0x23456789, 0x34567890]
        for c in pw:
            self.update(c)

    def update(self, c):
        k0, k1, k2 = self.k
        k0 = CRC[(k0 ^ c) & 0xFF] ^ (k0 >> 8)
        k1 = ((k1 + (k0 & 0xFF)) * 134775813 + 1) & 0xFFFFFFFF
        k2 = CRC[(k2 ^ (k1 >> 24)) & 0xFF] ^ (k2 >> 8)
        self.k = [k0, k1, k2]

    def encrypt(self, data):
        out = bytearray(len(data))
        for i, p in enumerate(data):
            t = (self.k[2] | 2) & 0xFFFF
            out[i] = p ^ (((t * (t ^ 1)) >> 8) & 0xFF)
            self.update(p)
        return bytes(out)


def dos_time(ts):
    d = datetime.datetime.fromtimestamp(ts, datetime.timezone.utc)
    return ((d.hour << 11) | (d.minute << 5) | (d.second // 2)), (((d.year - 1980) << 9) | (d.month << 5) | d.day)


def write_zip(fh, entries, pw=PASSWORD, now=None):
    # entries: iterable of (name, bytes). Each member is deflated, encrypted and written before the next is read, so
    # at most one file is in memory. Flag bit 0 = encrypted, no data descriptor (sizes are known). Returns member count.
    t, d = dos_time(now or time.time())
    central, off = [], 0
    for name, data in entries:
        nb = name.encode("ascii")
        crc = zlib.crc32(data) & 0xFFFFFFFF
        co = zlib.compressobj(9, zlib.DEFLATED, -15)
        comp = co.compress(data) + co.flush()
        zc = ZipCrypto(pw)
        head = bytearray(os.urandom(11)) + bytes([crc >> 24])     # last byte of the 12 lets a reader check the password
        enc = zc.encrypt(bytes(head)) + zc.encrypt(comp)
        local = struct.pack("<IHHHHHIIIHH", 0x04034B50, 20, 1, 8, t, d, crc, len(enc), len(data), len(nb), 0) + nb
        fh.write(local + enc)
        # made by Unix (3), external attributes = regular file 0600: nothing extracts with an execute bit
        central.append(struct.pack("<IHHHHHHIIIHHHHHII", 0x02014B50, (3 << 8) | 20, 20, 1, 8, t, d, crc, len(enc), len(data),
                                   len(nb), 0, 0, 0, 0, (0o100600 << 16), off) + nb)
        off += len(local) + len(enc)
    cd = b"".join(central)
    fh.write(cd + struct.pack("<IHHHHIIH", 0x06054B50, 0, 0, len(central), len(central), len(cd), off, 0))
    return len(central)


def publish(tmp, stamp):
    # Give the finished zip a name of its own: samples-STAMP.zip, or -2, -3... when another run took that one.
    # os.link never overwrites, so two runs in the same second both keep their archive.
    for i in range(1, 100):
        out = os.path.join(OUT_DIR, "samples-%s%s.zip" % (stamp, "" if i == 1 else "-%d" % i))
        try:
            os.link(tmp, out)
            return out
        except FileExistsError:
            continue
    raise OSError("no free file name in %s" % OUT_DIR)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__ or "usage: hp-sample-zip SHA256 [SHA256 ...]")
        return 2
    wanted = []
    for a in argv[1:]:
        a = a.strip().lower()
        if not SHA_RE.fullmatch(a):
            print("not a SHA-256: %r" % a[:80], file=sys.stderr)
            return 2
        if a not in wanted:
            wanted.append(a)
    if len(wanted) > MAX_FILES:
        print("at most %d files per zip" % MAX_FILES, file=sys.stderr)
        return 2
    found = find(set(wanted), download_dirs())
    picked, total = [], 0
    for sha in wanted:
        if sha not in found:
            continue
        if total + found[sha][2] > MAX_TOTAL:
            print("skipped %s: the zip would pass %d MB" % (sha, MAX_TOTAL >> 20), file=sys.stderr)
            continue
        total += found[sha][2]
        picked.append(sha)
    if not picked:
        print("none of the files were found on this honeypot (Cowrie's downloads may have been cleaned up)", file=sys.stderr)
        return 1
    now = time.time()
    included, manifest = [], []

    def members():
        for sha in picked:
            path, name, _size = found[sha]
            try:
                fd, _st = open_plain(path)
            except OSError:
                continue
            if fd is None:
                continue
            try:
                data = read_fd(fd)
            finally:
                os.close(fd)
            if data is None or hashlib.sha256(data).hexdigest() != sha:   # changed or replaced since it was found
                continue
            included.append(sha)
            manifest.append("%s  %9d  %s" % (sha, len(data), name))
            yield sha + ".bin", data
        text = ("Files captured by a honeypot (Cowrie), collected with Huginn's hp-sample-zip on %s UTC.\n"
                "They are live malware: never run them. sha256, size in bytes, name on the honeypot:\n\n%s\n"
                % (datetime.datetime.fromtimestamp(now, datetime.timezone.utc).strftime("%Y-%m-%d %H:%M"), "\n".join(manifest)))
        yield "manifest.txt", text.encode("ascii", "replace")

    try:
        os.makedirs(OUT_DIR, mode=0o700, exist_ok=True)
        os.chmod(OUT_DIR, 0o700)
        fd, tmp = tempfile.mkstemp(prefix=".samples-", suffix=".tmp", dir=OUT_DIR)
    except OSError as e:
        print("cannot write to %s: %s" % (OUT_DIR, e.strerror or e), file=sys.stderr)
        return 1
    try:
        with os.fdopen(fd, "wb") as fh:
            write_zip(fh, members(), now=now)
        if not included:
            print("none of the files could be read again (changed or removed meanwhile)", file=sys.stderr)
            return 1
        out = publish(tmp, datetime.datetime.fromtimestamp(now, datetime.timezone.utc).strftime("%Y%m%d-%H%M%S"))
    except OSError as e:
        print("could not write the zip: %s" % (e.strerror or e), file=sys.stderr)
        return 1
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    print("wrote %s (%d file%s, %.1f KB), password: %s" % (out, len(included), "" if len(included) == 1 else "s",
                                                            os.path.getsize(out) / 1024.0, PASSWORD.decode()))
    for s_ in wanted:
        if s_ not in included:
            print("not included: %s" % s_)
    # The hashes really in the zip: paste them into Huginn (Files, Share with Sanesecurity) after sending it.
    print("included: %s" % " ".join(included))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
