#!/bin/bash
# hp-export — read-only log export for Huginn (part of Huginn, AGPL-3.0-or-later).
# Runs as a forced command in /root/.ssh/authorized_keys on the honeypot:
#   restrict,command="/usr/local/bin/hp-export" ssh-ed25519 AAAA... huginn
# No command: prints all logs in sections. "tty <sha256>": one Cowrie session recording as base64.
# "goodbye on" / "goodbye off": the optional logout note (Settings in Huginn).
# "ids on" / "ids off": start or stop a Suricata that update-honeypot.sh --suricata-on already set up. Nothing is
# installed or configured this way. These four commands are the only changes Huginn can make here.
# "tty <sha256> <sha256> ...": up to 50 recordings, one line each: "<sha256> <base64>" or "<sha256> -" if gone.
# Settings (optional) in /etc/default/hp-export:
COWRIE_DIRS="/home/cowrie/cowrie"            # one or more Cowrie install dirs (several = several personas)
OPENCANARY_LOG="/home/opencanary/opencanary.log"
ENDLESSH_UNIT="endlessh"
TRAPS_LOG_DIR="/var/log/hp-traps"
FILEINFO_USER="cowrie"                         # unprivileged user that may read the Cowrie downloads
PERSONAS_FILE="/etc/huginn-honeypot/personas"  # "internal port=persona" per line (written by install-honeypot.sh)
BAIT_FILE="/etc/huginn-honeypot/bait.json"     # the fake credentials planted in the personas
IDENTITY_HISTORY="/var/lib/hp-identity/history"  # what the web trap has pretended to be (written by hp-identity)
SURICATA_FLAG="/etc/huginn-honeypot/suricata"    # Suricata is on (honeypot/setup-suricata.sh)
SURICATA_EVE="/var/log/suricata/eve.json"
[ -r /etc/default/hp-export ] && . /etc/default/hp-export
FIRST_COWRIE="${COWRIE_DIRS%% *}"
export HP_DOWNLOAD_DIRS="${HP_DOWNLOAD_DIRS:-$FIRST_COWRIE/var/lib/cowrie/downloads}"
case "${SSH_ORIGINAL_COMMAND:-}" in
  "") ;;
  tty\ *)
    read -r -a shas <<< "${SSH_ORIGINAL_COMMAND#tty }"
    [ "${#shas[@]}" -ge 1 ] && [ "${#shas[@]}" -le 50 ] || { echo "bad request" >&2; exit 2; }
    for sha in "${shas[@]}"; do [[ "$sha" =~ ^[0-9a-f]{64}$ ]] || { echo "bad request" >&2; exit 2; }; done
    # Recordings belong to the Cowrie user, so read them as that user: root must not open what an attacker can swap.
    exec timeout 300 setpriv --reuid="${FILEINFO_USER:-cowrie}" --regid="${FILEINFO_USER:-cowrie}" --clear-groups --no-new-privs bash -c '
      dir="$1"; shift
      if [ "$#" = 1 ]; then
        f="$dir/$1"
        [ -f "$f" ] && [ ! -L "$f" ] || { echo "not found" >&2; exit 3; }
        base64 -w0 "$f"; echo; exit 0
      fi
      for sha in "$@"; do
        f="$dir/$sha"
        if [ -f "$f" ] && [ ! -L "$f" ]; then printf "%s " "$sha"; base64 -w0 "$f"; echo; else echo "$sha -"; fi
      done
    ' tty "$FIRST_COWRIE/var/lib/cowrie/tty" "${shas[@]}" ;;
  "goodbye on"|"goodbye off")
    # 0.41: turn the logout note on or off (the same flag file as update-honeypot.sh --goodbye-on). Exactly these two
    # commands, nothing taken from them but on/off; the answer is one line with the state now.
    f=/etc/huginn-goodbye
    if [ "$SSH_ORIGINAL_COMMAND" = "goodbye on" ]; then
      [ ! -L "$f" ] || { echo "refused: $f is a symlink" >&2; exit 2; }
      [ -f "$f" ] || install -m 644 -o root -g root /dev/null "$f" || { echo "could not create $f" >&2; exit 2; }
      want=on
    else
      rm -f "$f" || { echo "could not remove $f" >&2; exit 2; }
      want=off
    fi
    # Only report success when the flag really is in the state asked for.
    if [ -f "$f" ] && [ ! -L "$f" ]; then now=on; else now=off; fi
    [ "$now" = "$want" ] || { echo "goodbye is still $now" >&2; exit 2; }
    echo "goodbye $now"
    exit 0 ;;
  "ids on"|"ids off")
    # 0.44: Suricata on or off from Huginn's Settings. Only a Suricata that is installed, configured and has rules
    # can be started; the answer is one line with the state now (start is checked, loading the rules goes on after).
    f=/etc/huginn-honeypot/suricata
    [ ! -L "$f" ] || { echo "refused: $f is a symlink" >&2; exit 2; }
    if [ "$SSH_ORIGINAL_COMMAND" = "ids on" ]; then
      if ! { command -v suricata >/dev/null && [ -f /etc/huginn-honeypot/suricata.yaml ] && [ -f /etc/systemd/system/suricata.service.d/huginn.conf ] \
             && [ -s /var/lib/suricata/rules/suricata.rules ]; }; then
        echo "Suricata is not set up on the honeypot: run ./update-honeypot.sh --suricata-on there once" >&2; exit 2
      fi
      # The same lock as setup-suricata.sh: a rule update or a manual run is never half done under this (Codex 049 M9).
      exec 9>/run/hp-suricata.lock; flock -w 60 9 || { echo "another Suricata change is running, try again in a minute" >&2; exit 2; }
      install -m 644 -o root -g root /dev/null "$f" || { echo "could not create $f" >&2; exit 2; }
      systemctl enable --now suricata hp-suricata-rules.timer >/dev/null 2>&1 || true
      # On means all three: flag, engine and the daily rule timer. Anything less goes back to off, so the export never
      # says on while the engine is down.
      if systemctl is-active --quiet suricata && systemctl is-active --quiet hp-suricata-rules.timer; then echo "ids on"; exit 0; fi
      rm -f "$f"; systemctl disable --now hp-suricata-rules.timer suricata >/dev/null 2>&1 || true
      echo "Suricata did not start, so it was turned off again (see journalctl -u suricata on the honeypot)" >&2; exit 2
    else
      exec 9>/run/hp-suricata.lock; flock -w 60 9 || { echo "another Suricata change is running, try again in a minute" >&2; exit 2; }
      rm -f "$f"
      systemctl disable --now hp-suricata-rules.timer suricata >/dev/null 2>&1 || true
      if systemctl is-active --quiet suricata || systemctl is-active --quiet hp-suricata-rules.timer; then echo "Suricata is still running" >&2; exit 2; fi
      echo "ids off"
    fi
    exit 0 ;;
  *) ;;  # any other command gets the normal export
esac
# The newest lines of the logs matching a pattern, oldest first: hp-readlogs reads from the end and stops early (M20),
# and never reads as root what a service user could redirect (H1: it drops to the folder's owner). No match: no output.
readlogs() { python3 -I /usr/local/bin/hp-readlogs "$1" "$2" 0 2>/dev/null; return 0; }
# Attackers choose how long a logged line is: drop the absurd ones and cap each log, so they cannot make the export refused.
keep() { LC_ALL=C awk 'length($0) <= 16384' | tail -c 50331648; }
WARNS=()
echo "##COWRIE"
for d in $COWRIE_DIRS; do readlogs "$d/var/log/cowrie/cowrie.json*" 30000 | keep; done
echo "##CANARY"
readlogs "$OPENCANARY_LOG*" 10000 | keep
echo "##ENDLESSH"
journalctl -u "$ENDLESSH_UNIT" --no-pager -o cat --since "30 days ago" 2>/dev/null | grep -E " (ACCEPT|CLOSE) host=" | tail -n 20000
[ "${PIPESTATUS[0]}" = 0 ] || WARNS+=("journal")
echo "##NFT"
nft list ruleset 2>/dev/null | grep -o "dport [0-9]* counter packets [0-9]*"
echo "##TRAPS"
readlogs "$TRAPS_LOG_DIR/traps-*.json" 20000 | keep
# Personas and bait, so Huginn needs no extra settings. The bait is fake and already sits in the fake file systems.
if [ -r "$PERSONAS_FILE" ]; then echo "##PERSONAS"; grep -E '^[0-9]{1,5}=[A-Za-z0-9_.-]{1,20}$' "$PERSONAS_FILE"; fi
if [ -r "$IDENTITY_HISTORY" ]; then echo "##IDENTITY"; tail -n 500 "$IDENTITY_HISTORY" | grep -E '^[0-9]{9,11} [a-z0-9-]{1,32} (nas|router) [A-Za-z0-9 !+._-]{1,48}$' || true; fi
if [ -r "$BAIT_FILE" ]; then echo "##BAIT"; head -c 20000 "$BAIT_FILE" | tr -d '\n'; echo; fi
# Optional Suricata alerts (update-honeypot.sh --suricata-on). Only alerts on traffic TO this machine, rewritten as a few
# fixed fields: the honeypot's own fake replies (a planted /etc/passwd...) also match rules, but they are not the attacker.
if [ -f "$SURICATA_FLAG" ]; then
  echo "##IDS"
  # Filtered first, then the newest 20000: the honeypot's own reply alerts must not push real ones out of the window
  # (only absurd line lengths are dropped before the filter, no byte budget). "h" identifies the original line, so two
  # alerts that look the same here (two connections, same second) both count. "dropped N": more than fit since the
  # oldest line in eve.json, so Huginn can say that some were not counted.
  readlogs "$SURICATA_EVE*" 0 | LC_ALL=C awk 'length($0) <= 16384' | python3 -I -c '
import collections, hashlib, ipaddress, json, sys
own = set()
for a in sys.argv[1].split():
    try:
        own.add(ipaddress.ip_address(a))
    except ValueError:
        pass
def addr(s):
    try:
        return ipaddress.ip_address(s)
    except (ValueError, TypeError):
        return None
out, total = collections.deque(maxlen=20000), 0
for line in sys.stdin.buffer:
    if b"alert" not in line:
        continue
    try:
        e = json.loads(line)
        a = e["alert"]
        if e.get("event_type") != "alert" or addr(e.get("dest_ip")) not in own or addr(e.get("src_ip")) in own:
            continue
        total += 1
        out.append(json.dumps({"t": e["timestamp"], "ip": e["src_ip"], "port": e.get("dest_port"), "proto": e.get("proto"),
                          "sid": a["signature_id"], "rev": a.get("rev"), "sev": a.get("severity"),
                          "sig": a.get("signature"), "cat": a.get("category"),
                          "h": hashlib.sha1(line.rstrip(b"\n")).hexdigest()[:20]}, ensure_ascii=True))
    except (ValueError, KeyError, TypeError, AttributeError):
        continue
sys.stdout.write("".join(x + "\n" for x in out))
if total > len(out):
    print("dropped %d" % (total - len(out)))
' "$(hostname -I 2>/dev/null)"
  r=/var/lib/suricata/rules/suricata.rules
  [ -f "$r" ] && [ ! -L "$r" ] && echo "rules $(stat -c %Y "$r")"
fi
# What protects the honeypot, as fixed words only: Huginn shows it and alerts when something is missing (a drop-in removed
# because a service would not start with it, a patch that no longer fits after a Cowrie upgrade, a service that stopped).
echo "##STATUS"
if [ -f "$SURICATA_FLAG" ]; then
  if systemctl is-active --quiet suricata; then echo "running:suricata ok"; else echo "running:suricata missing"; fi
  if systemctl is-active --quiet hp-suricata-rules.timer; then echo "running:suricata-rules ok"; else echo "running:suricata-rules missing"; fi
fi
# A choice, not protection: "ok" = Suricata is set up here, so Huginn's Settings may turn it on.
if command -v suricata >/dev/null && [ -f /etc/huginn-honeypot/suricata.yaml ] && [ -s /var/lib/suricata/rules/suricata.rules ]; then
  echo "option:suricata ok"; else echo "option:suricata missing"; fi
for u in cowrie cowrie-camera opencanary; do
  [ -f "/etc/systemd/system/$u.service" ] || continue
  d="/etc/systemd/system/$u.service.d"
  if [ -f "$d/huginn-sandbox.conf" ]; then echo "sandbox:$u ok"; else echo "sandbox:$u missing"; fi
  if [ -f "$d/huginn-limits.conf" ]; then echo "limits:$u ok"; else echo "limits:$u missing"; fi
  if systemctl is-active --quiet "$u"; then echo "running:$u ok"; else echo "running:$u missing"; fi
done
# The Cowrie user owns these files, so they are read as that user (H1): root never opens what it could swap.
src="$FIRST_COWRIE/src/cowrie"
SRC_UID=$(stat -c %u "$FIRST_COWRIE" 2>/dev/null || echo 0); SRC_GID=$(stat -c %g "$FIRST_COWRIE" 2>/dev/null || echo 0)
asowner() { if [ "$SRC_UID" != 0 ]; then setpriv --reuid="$SRC_UID" --regid="$SRC_GID" --clear-groups --no-new-privs "$@"; else "$@"; fi; }
mark() { if [ -f "$2" ] && [ ! -L "$2" ] && asowner grep -qsF "$3" "$2"; then echo "patch:$1 ok"; else echo "patch:$1 missing"; fi; }
if [ -d "$src" ]; then
  # Newer Cowrie reads the persona's /proc/meminfo itself (upstream ae716fe): the patch is then not needed.
  if [ -f "$src/commands/free.py" ] && [ ! -L "$src/commands/free.py" ] && asowner grep -qsF 'self.fs.file_contents("/proc/meminfo")' "$src/commands/free.py"; then
    echo "patch:free ok"; else mark free "$src/commands/free.py" "Huginn patch"; fi
  mark proxy "$src/ssh/forwarding.py" "Huginn proxyreply"
  mark ping "$src/commands/ping.py" "Huginn ping v1"
  mark upload "$src/shell/server.py" "Huginn upload v1"
  mark wget "$src/commands/wget.py" "Huginn wget v1"
  mark exec "$src/shell/protocol.py" "Huginn exec v1"
  # Two files, one patch: the note (bash.py) and the line counter (protocol.py) must both be there.
  # Same order as mark(): a regular file that is not a symlink, and only then read it.
  p="$src/shell/protocol.py"
  if [ -f "$p" ] && [ ! -L "$p" ] && asowner grep -qsF "Huginn goodbye count v1" "$p"; then mark goodbye "$src/commands/bash.py" "Huginn goodbye v1"; else echo "patch:goodbye missing"; fi
fi
# A choice, not protection: "ok" = the logout note is on. Huginn shows it and never alerts on it.
if [ -f /etc/huginn-goodbye ] && [ ! -L /etc/huginn-goodbye ]; then echo "option:goodbye ok"; else echo "option:goodbye missing"; fi
# OpenCanary's files belong to its own user: read them as that one.
OC_HOME="$(dirname "$OPENCANARY_LOG")"
SRC_UID=$(stat -c %u "$OC_HOME" 2>/dev/null || echo 0); SRC_GID=$(stat -c %g "$OC_HOME" 2>/dev/null || echo 0)
for f in "$OC_HOME"/oc-env/lib/python3*/site-packages/opencanary/modules/http.py; do
  [ -f "$f" ] && mark webreply "$f" "Huginn webreply"
  break
done
echo "##FILES"
# The captured files are attacker data: analyse them as the Cowrie user (who already owns them), never as root.
FILEINFO_USER="${FILEINFO_USER:-cowrie}"
install -d -m 700 -o "$FILEINFO_USER" -g "$FILEINFO_USER" /var/lib/hp-export 2>/dev/null
timeout 120 setpriv --reuid="$FILEINFO_USER" --regid="$FILEINFO_USER" --clear-groups --no-new-privs \
  env HP_DOWNLOAD_DIRS="$HP_DOWNLOAD_DIRS" python3 -I /usr/local/bin/hp-fileinfo 2>/dev/null || WARNS+=("fileinfo")
for w in "${WARNS[@]}"; do echo "##WARN $w"; done
echo "##END"
