def is_dark(colour):
    r, g, b = (int(colour[i:i + 2], 16) for i in (1, 3, 5))
    return 0.299 * r + 0.587 * g + 0.114 * b < 110


def login_page(ident, model):
    if ident["layout"] == "builtin":
        ident = dict(ident, layout="card", accent="#2875b5", bg="#eef2f6")
    e = {k: html.escape(str(ident[k])) for k in ("vendor", "product", "accent", "bg")}
    m, layout = html.escape(model), ident["layout"]
    vals = {"bg": ident["bg"], "accent": ident["accent"], "fg": "#fff" if is_dark(ident["bg"]) else "#222"}
    css = (BASE + LAYOUTS[layout]) % vals
    head = '<div class="b">%s</div><div class="p">%s %s</div>' % (e["vendor"], e["product"], m)
    if layout == "split":
        body = '<div class="w"><div class="l" id="l">%s</div><div class="c"><h2>Sign in</h2>%s</div></div>' % (head, FORM)
        css += ".l{background:%s}" % ident["accent"]
    elif layout in ("topbar", "classic"):
        body = '<div class="t">%s %s</div><div class="c"><div class="p">%s %s</div>%s<div class="foot">Authorized users only.</div></div>' % (e["vendor"], e["product"], e["vendor"], m, FORM)
    else:
        body = '<div class="w"><div class="c">%s%s<div class="foot">%s %s</div></div></div>' % (head, FORM, e["vendor"], m)
    return ('<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">'
            '<title>%s %s</title><style>%s</style></head><body>%s</body></html>\n' % (e["vendor"], e["product"], css, body))


def plain_error(code, text):
    return ('<!DOCTYPE HTML PUBLIC "-//IETF//DTD HTML 2.0//EN">\n<html><head><title>%s %s</title></head><body><h1>%s</h1>'
            '<p>The requested URL [[URL]] %s.</p><hr><address>[[BANNER]]</address></body></html>\n' % (code, text, text, "was not found on this server" if code == "404" else "cannot be accessed"))


def build_skin(ident, model, root=SKINS):
    # Owned by root and outside OpenCanary's home: the web service can read its pages but not change them.
    # A new folder every time: the one in use must survive until the new one has proved it works.
    final = tempfile.mkdtemp(prefix=ident["id"] + "-", dir=root)
    os.mkdir(os.path.join(final, "static"))
    pages = {"index.html": login_page(ident, model), "404.html": plain_error("404", "Not Found"), "403.html": plain_error("403", "Forbidden"),
             "400.html": plain_error("400", "Bad Request"),
             "redirect.html": '<html><head><title>Redirect</title></head><body><a href="/index.html">Click here</a></body></html>\n'}
    for name, text in pages.items():
        with open(os.path.join(final, name), "w", encoding="utf-8") as fh:
            fh.write(text)
        os.chmod(os.path.join(final, name), 0o644)       # whatever umask this shell has: OpenCanary is another user
    os.chmod(os.path.join(final, "static"), 0o755)
    hpw_write_skin(final, ident)
    os.chmod(final, 0o755)
    return final


def as_canary(*cmd, stdin=None):
    # OpenCanary's home belongs to an internet-facing service: root must not write or follow anything in it.
    return subprocess.run(["runuser", "-u", OC_USER, "--"] + list(cmd), input=stdin, capture_output=True, text=True, timeout=120)


CONF_EDIT = r"""
import json, os, sys
path, change = sys.argv[1], json.loads(sys.stdin.read())
c = json.load(open(path))
for k, v in change.items():
    if v is None:
        c.pop(k, None)
    else:
        c[k] = v
tmp = "%s.identity.%d" % (path, os.getpid())
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, os.stat(path).st_mode & 0o777)
with os.fdopen(fd, "w") as fh:
    json.dump(c, fh, indent=2)
os.replace(tmp, path)
"""


def read_conf():
    r = as_canary("cat", CONF)
    if r.returncode:
        raise SystemExit("Cannot read the OpenCanary settings: %s" % r.stderr.strip())
    return json.loads(r.stdout)


def write_conf(change):
    r = as_canary("/usr/bin/python3", "-I", "-c", CONF_EDIT, CONF, stdin=json.dumps(change))
    if r.returncode:
        raise SystemExit("Cannot write the OpenCanary settings: %s" % r.stderr.strip())


def ensure_cert(ident):
    pem, key = "%s/%s.pem" % (CERTS, ident["id"]), "%s/%s.key" % (CERTS, ident["id"])
    as_canary("mkdir", "-p", "-m", "700", CERTS)
    if as_canary("test", "-s", key).returncode or as_canary("test", "-s", pem).returncode:
        name = ident["cn"]
        r = as_canary("openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650", "-subj", "/CN=" + name,
                      "-addext", "subjectAltName=DNS:" + name, "-keyout", key, "-out", pem)
        if r.returncode:
            raise SystemExit("Cannot make a certificate: %s" % r.stderr.strip()[:300])
        as_canary("chmod", "600", key)
    return pem, key


def serving(banner, port, secs=45):
    # OpenCanary needs a few seconds. It only counts when the new Server header is what actually answers.
    end = time.monotonic() + secs
    while time.monotonic() < end:
        time.sleep(1)
        try:
            c = http.client.HTTPConnection("127.0.0.1", port, timeout=4)
            c.request("GET", "/index.html", headers={"User-Agent": "hp-identity"})
            r = c.getresponse()
            got = r.getheader("Server")
            r.read()
            c.close()
            if r.status == 200 and (banner is None or got == banner):      # None: any answer, for a setup without a banner of its own
                return True
        except (OSError, http.client.HTTPException):
            pass
    return False


def restart():
    # reset-failed: systemd refuses a service restarted too often, which would leave the web trap down until someone notices.
    subprocess.run(["systemctl", "reset-failed", "opencanary"], check=False, timeout=30, capture_output=True)
    subprocess.run(["systemctl", "restart", "opencanary"], check=False, timeout=60)


def history():
    out = []
    try:
        with open(HISTORY, encoding="utf-8") as fh:
            for line in fh:
                p = line.rstrip("\n").split(" ", 3)
                if len(p) == 4 and p[0].isdigit() and p[1] in IDENTITIES:
                    out.append((int(p[0]), p[1], p[2], p[3]))
    except FileNotFoundError:
        pass
    return out


def lock():
    # One change at a time: the timer, a manual change and the first setup all come through here.
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    fd = os.open(LOCK, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def save_pending(before, stamp, ident_id, refresh=False, committed=False):
    tmp = "%s.%d" % (PENDING, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump({"before": before, "stamp": stamp, "id": ident_id, "refresh": refresh, "committed": committed}, fh)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, PENDING)


def clear_pending():
    try:
        os.remove(PENDING)
    except FileNotFoundError:
        pass


def recover():
    # A change that never finished (killed, power cut): go back to what was there before it.
    try:
        with open(PENDING, encoding="utf-8") as fh:
            p = json.load(fh)
        if not isinstance(p, dict) or not isinstance(p.get("before", {}), dict):
            raise ValueError("not an object")
    except FileNotFoundError:
        return
    except ValueError:
        os.replace(PENDING, PENDING + ".bad")      # unreadable: keep it for a human, and say so
        print("A note about an interrupted change could not be read: see %s.bad" % PENDING)
        return
    last = history()[-1:]
    if p.get("committed") or (not p.get("refresh") and last and last[0][0] == p.get("stamp") and last[0][1] == p.get("id")):
        clear_pending()                            # the history line was written: that change was finished, only the tidying was not
        return
    before = p.get("before", p) if "stamp" in p else p      # a note from 0.23.0 is the old settings on their own
    write_conf(before)
    restart()
    if not serving(before.get("http.banner"), int(read_conf().get("http.port", 8080))):
        raise SystemExit("Went back after an interrupted change, but OpenCanary did not come up: check the opencanary service.")
    clear_pending()
    print("Finished an interrupted change by going back.")


def prune_skins(keep):
    # Only after a change is confirmed. The old folder was the way back until now.
    for d in glob.glob(os.path.join(SKINS, "*")):
        if d != keep and os.path.isdir(d):
            shutil.rmtree(d, ignore_errors=True)


def add_history(stamp, ident, label):
    fd = os.open(HISTORY, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("%d %s %s %s\n" % (stamp, ident["id"], ident["kind"], label))
        fh.flush()
        os.fsync(fh.fileno())


def apply_identity(ident, refresh=False):
    if not os.path.isdir(OC_HOME):
        raise SystemExit("OpenCanary is not installed here.")
    previous = history()[-1:]
    model = random.SystemRandom().choice(ident["models"])
    if refresh and previous:
        model = previous[0][3].removeprefix(ident["vendor"] + " ")
    label = "%s %s" % (ident["vendor"], model)
    if not LABEL_RE.match(label):
        raise SystemExit("Bad label: %s" % label)
    conf = read_conf()
    keys = ("http.banner", "http.skin", "http.skindir", "https.skin", "https.certificate", "https.key")
    before = {k: conf.get(k) for k in keys}
    pem, key = ensure_cert(ident)
    port = int(conf.get("http.port", 8080))
    skin = None
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    stamp = int(time.time())       # also what ties this note to the history line, see recover()
    size_before = os.path.getsize(HISTORY) if os.path.exists(HISTORY) else 0
    save_pending(before, stamp, ident["id"], refresh=refresh)
    try:
        # Every identity gets a generated skin, including the formerly builtin Synology.
        skin = build_skin(ident, model)
        change = {"http.skin": ident["id"], "https.skin": ident["id"], "http.skindir": skin}
        change.update({"http.banner": ident["banner"], "https.certificate": pem, "https.key": key})
        write_conf(change)
        restart()
        if not serving(ident["banner"], port):
            raise RuntimeError("did not come up")
        if not refresh:
            add_history(stamp, ident, label)
    except (Exception, SystemExit) as e:
        go_back(ident, before, port, skin, e, size_before)
    if refresh:
        # Mark a history-preserving refresh committed before removing its recovery note.
        save_pending(change, stamp, ident["id"], refresh=True, committed=True)
    clear_pending()
    prune_skins(skin)
    print("Now: %s (%s)" % (label, ident["kind"]))


def go_back(ident, before, port, skin, why, size_before=0):
    # PENDING stays until the old identity really is back, so a failure here is retried by the next run.
    try:
        write_conf(before)
        restart()
        if not serving(before.get("http.banner"), port):
            raise RuntimeError("no answer")
        if os.path.exists(HISTORY) and os.path.getsize(HISTORY) > size_before:
            os.truncate(HISTORY, size_before)          # the line may have been written before the error: the change did not happen
    except (Exception, SystemExit):
        raise SystemExit("%s failed (%s) and the previous identity did not come back: check the opencanary service." % (ident["id"], why))
    clear_pending()
    if skin:
        shutil.rmtree(skin, ignore_errors=True)
    raise SystemExit("%s failed (%s), went back to the previous identity." % (ident["id"], why))


def choose(recent):
    # Any device that has not been used lately, NAS or router alike.
    avoid = set(recent[-KEEP_RECENT:])
    return random.SystemRandom().choice([k for k in IDENTITIES if k not in avoid])


def rotate_days():
    try:
        with open(DEFAULTS, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"^ROTATE_DAYS=(\d{1,4})\s*$", line)
                if m:
                    return int(m.group(1))
    except FileNotFoundError:
        pass
    return 21


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    if cmd == "list":
        for k, v in IDENTITIES.items():
            print("%-18s %-7s %s %s (%s)" % (k, v["kind"], v["vendor"], v["product"], ", ".join(v["models"])))
        return 0
    if cmd == "status":
        h = history()
        days = rotate_days()
        print("Rotation: every %d days" % days if days else "Rotation: off")
        if not h:
            print("No identity set yet.")
            return 0
        print("Now: %s (%s), since %s" % (h[-1][3], h[-1][1], time.strftime("%Y-%m-%d %H:%M", time.localtime(h[-1][0]))))
        return 0
    if os.geteuid() != 0:
        raise SystemExit("Run as root.")
    if cmd not in ("set", "rotate", "refresh"):
        print("Usage: hp-identity list | status | set <id>|random | rotate | refresh")
        return 2
    held = lock()
    if held is None:
        if cmd == "rotate":
            return 0                # someone is changing it right now: tomorrow's check will do
        raise SystemExit("Another change is running. Try again in a minute.")
    recover()
    h = history()                   # read under the lock, so it cannot change between here and the decision
    if cmd == "refresh":
        if not h or h[-1][1] not in IDENTITIES:
            raise SystemExit("No known identity to refresh; set one first.")
        apply_identity(IDENTITIES[h[-1][1]], refresh=True)
        return 0
    if cmd == "set" and len(argv) == 3:
        pick = choose([x[1] for x in h]) if argv[2] == "random" else argv[2]
        if pick not in IDENTITIES:
            raise SystemExit("Unknown identity. See: hp-identity list")
        apply_identity(IDENTITIES[pick])
        return 0
    if cmd == "rotate":
        days = rotate_days()
        if not days or (h and time.time() - h[-1][0] < days * 86400):
            return 0
        apply_identity(IDENTITIES[choose([x[1] for x in h])])
        return 0
    print("Usage: hp-identity list | status | set <id>|random | rotate | refresh")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
