# Huginn in Docker: copy to .env next to docker-compose.yml. No secrets live here.
# Everything else from the main .env.example works too (HUGINN_BASE, HUGINN_PORT and HUGINN_BIND are set by the image).

# Honeypot to pull from (required) and its admin SSH port
HUGINN_HP_HOST=192.0.2.10
HUGINN_HP_PORT=22022

# Port on this machine for the web page
HUGINN_WEB_PORT=8095
HUGINN_TZ=Europe/Stockholm

# Days of history to keep; 0 keeps everything forever
HUGINN_RETENTION_DAYS=180

# ntfy push notifications (empty = off)
# HUGINN_NTFY_URL=http://ntfy.lan:2586/huginn
# HUGINN_PUBLIC_URL=http://huginn.lan:8095

# Look captured files up on MalwareBazaar by SHA-256 (only the hash is sent). Free key: https://auth.abuse.ch
# HUGINN_MALWAREBAZAAR_KEY=

# Pin an image version instead of latest, e.g. 0.14.0
# HUGINN_TAG=latest
