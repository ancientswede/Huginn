# Huginn settings — copy to /opt/huginn/.env (read by systemd). No secrets live here.

# Honeypot to pull from (required). Huginn connects out; the honeypot never connects to Huginn.
HUGINN_HP_HOST=192.0.2.10
HUGINN_HP_PORT=22022
# HUGINN_HP_KEY=/opt/huginn/.ssh/honeypot_ro
# HUGINN_HP_KNOWN=/opt/huginn/.ssh/known_hosts

# Web UI
HUGINN_PORT=8095
HUGINN_BIND=0.0.0.0
HUGINN_TZ=Europe/Stockholm
# Reverse proxy that may set X-Forwarded-For / X-Forwarded-Proto (comma separated IPs)
# HUGINN_TRUSTED_PROXIES=192.0.2.20

# Collection
HUGINN_POLL=120
# Days of history to keep; 0 keeps everything forever
HUGINN_RETENTION_DAYS=180

# Automatic copies of the database in data/backups: how many to keep (0 = off) and how often
# HUGINN_DB_BACKUPS=3
# HUGINN_DB_BACKUP_HOURS=24
# Country/network/Shodan lookups for attacker IPs (sends attacker IPs only to ipwho.is and internetdb.shodan.io)
HUGINN_ENRICH=1

# Persona per internal Cowrie port. Normally not needed: install-honeypot.sh announces it through the export.
# HUGINN_PERSONAS=2225=server,2323=camera

# Daily check for a newer Huginn version on GitHub (reads the public tag list, sends nothing about you)
# HUGINN_UPDATE_CHECK=0

# Your own public IP(s) and domain names, comma separated: replaced with [self] in stored data
# (attackers often send the address they target, e.g. in HTTP Host headers)
# HUGINN_MASK=198.51.100.7,example.com

# Extra bait values to watch for (JSON object, see examples/bait.example.json). The honeypot's own are announced.
# HUGINN_C2_EXCLUDE=1.2.3.4,5.6.7.8
# HUGINN_ALLOWED_HOSTS=huginn.lan:8095
# HUGINN_BAIT_FILE=/opt/huginn/bait.json

# Look captured files up on MalwareBazaar (abuse.ch) by SHA-256; only the hash is sent. Free key: https://auth.abuse.ch
# (or paste it on the Settings page, Lookups)
# HUGINN_MALWAREBAZAAR_KEY=
# VirusTotal verdicts for captured files (only the SHA-256 is sent). You can also paste the key on the Settings page.
# HUGINN_VIRUSTOTAL_KEY=
# HUGINN_VIRUSTOTAL_DAILY=400
# GreyNoise community lookups for attacker addresses (no key needed; a free key raises the allowance). 0 turns them off.
# HUGINN_GREYNOISE_DAILY=20   # default: 20 without a key, 40 with one
# HUGINN_GREYNOISE_KEY=

# ntfy push notifications, max one summary per hour and a weekly summary on Sunday evening (empty = off)
# HUGINN_NTFY_URL=http://ntfy.lan:2586/huginn
# HUGINN_NTFY_TOKEN=tk_...            # only if your ntfy server uses access control
# HUGINN_PUBLIC_URL=http://huginn.lan:8095

# Prometheus metrics on /metrics: turn on in Settings, or give a token here (16+ characters). See examples/grafana.
# HUGINN_METRICS_TOKEN=
# Logs: json = one JSON object per line for Loki; level debug|info|warning|error
# HUGINN_LOG_FORMAT=text
# HUGINN_LOG_LEVEL=
