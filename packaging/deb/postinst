#!/bin/sh
# The code runs from /opt/huginn, which only the setup and update scripts write to. That way an
# upgrade gets the same backup and automatic rollback as update-huginn.sh, and a machine installed
# with the scripts can move to the package as it is.
set -e
[ "$1" = configure ] || exit 0

SRC=/usr/share/huginn
if [ -f /opt/huginn/app.py ]; then
  cmp -s "$SRC/app.py" /opt/huginn/app.py && exit 0
  if ! systemctl is-enabled --quiet huginn 2>/dev/null; then
    # Not running as a service (turned off on purpose, or a half-done setup): leave /opt/huginn alone, but say so.
    echo "WARNING: /opt/huginn still has the old Huginn code because the huginn service is not enabled." >&2
    echo "         If the setup never finished, run: huginn-setup" >&2
    echo "         Otherwise enable it and update with: systemctl enable huginn && $SRC/update-huginn.sh" >&2
    exit 0
  fi
  # A failed update has already put the old version back. Fail here too, so the package is not marked as
  # configured with old code running; "dpkg --configure -a" (or the same apt install) then tries again.
  if ! "$SRC/update-huginn.sh"; then
    echo "ERROR: Huginn was not updated, see the message above. The old version is still running." >&2
    echo "       Try again with: dpkg --configure -a" >&2
    exit 1
  fi
  exit 0
fi

cat <<'MSG'

  Huginn is unpacked. Connect it to your honeypot with:

    huginn-setup

MSG
